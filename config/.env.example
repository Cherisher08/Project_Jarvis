# ==============================================================================
# HOME LAB SYSTEM - Master Environment Variables Template (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the same directory: cp .env.example .env
# 2. Adjust values to match your home network and server configuration.
# 3. Secure the file permissions on Ubuntu Server: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL / SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
# The timezone for all containers (determines cron jobs, Home Assistant logs, etc.)
TZ=Asia/Kolkata

# User ID and Group ID under which containers run and write files.
# Running 'id' in your Ubuntu shell will show these values (typically 1000 for primary user).
PUID=1000
PGID=1000

# The static/reserved local IP address of your Mini PC on the home network.
# Replace this with your actual server IP once assigned on your router.
SERVER_IP=192.168.1.100

# ------------------------------------------------------------------------------
# SECURITY CAMERAS (FRIGATE NVR)
# ------------------------------------------------------------------------------
# Hikvision DVR credentials (used to pull RTSP streams from analog cameras)
CAMERA_USER=admin
CAMERA_PASS=change_this_to_your_hikvision_password

# IP address of your Hikvision DVR (all 4 analog cameras stream through this single IP)
DVR_IP=192.168.1.2

# ------------------------------------------------------------------------------
# SMART HOME (MOSQUITTO MQTT & HOME ASSISTANT)
# ------------------------------------------------------------------------------
# Credentials for the MQTT broker (used by Frigate, OwnTracks, Tasmota, HASS)
MQTT_USER=mqtt_user
MQTT_PASS=change_this_to_a_secure_mqtt_password

# ------------------------------------------------------------------------------
# PHOTO BACKUP (IMMICH)
# ------------------------------------------------------------------------------
# Database password for Immich's PostgreSQL instance (do not expose to the internet)
IMMICH_DB_PASSWORD=change_this_to_a_secure_db_password

# ------------------------------------------------------------------------------
# OFFSITE CLOUD BACKUPS (RESTIC & BACKBLAZE B2)
# ------------------------------------------------------------------------------
# Backblaze B2 Application Key Credentials (create these in the Backblaze B2 console)
B2_KEY_ID=your_backblaze_key_id
B2_APPLICATION_KEY=your_backblaze_app_key

# Restic Backup Target Repository (format: b2:BUCKET_NAME:PATH)
RESTIC_REPOSITORY=b2:my-homelab-backup-bucket:restic

# Password used to encrypt the Restic backup repository. Keep this safe!
# If you lose this password, you will NOT be able to restore your backups.
# Password used to encrypt the Restic backup repository. Keep this safe!
# If you lose this password, you will NOT be able to restore your backups.
RESTIC_PASSWORD=change_this_to_a_secure_encryption_password

# ------------------------------------------------------------------------------
# DNS & AD BLOCKING (PI-HOLE + UNBOUND)
# ------------------------------------------------------------------------------
# Password to log into the Pi-hole admin web UI at http://SERVER_IP:8080/admin
PIHOLE_WEBPASSWORD=change_this_to_a_secure_pihole_password

# Your home router's IP address (used for Pi-hole reverse/conditional DNS lookup)
# This allows Pi-hole to resolve local device hostnames like router.local
ROUTER_IP=192.168.1.1

# Your home network's subnet in CIDR notation
# Pi-hole uses this to map reverse DNS queries for local devices
LAN_SUBNET=192.168.1.0/24

# ------------------------------------------------------------------------------
# NOTIFICATIONS (NTFY)
# ------------------------------------------------------------------------------
# The base URL that NTFY uses to generate notification links.
# Use your Tailscale IP here if you want notifications to work outside home WiFi.
# Example with .home domain (requires Pi-hole running): http://notify.home
# Example with direct IP (always works):                http://192.168.1.100:2586
NTFY_BASE_URL=http://notify.home
