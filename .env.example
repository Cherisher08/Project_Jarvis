# ==============================================================================
# 4GB RAM Laptop Homelab - Unified Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Restrict permissions:  chmod 600 .env
# 3. Update all passwords, tokens, and storage paths below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Global Settings
# ------------------------------------------------------------------------------
# Set your local timezone (e.g., America/New_York, Europe/London, Asia/Kolkata)
TZ=Etc/UTC

# Host user/group IDs (find yours by running 'id' in terminal - default is 1000)
PUID=1000
PGID=1000

# Base paths on your Ubuntu Server
HOMELAB_ROOT=/opt/homelab
DATA_ROOT=/opt/homelab/data
MEDIA_ROOT=/opt/homelab/media
CONFIG_ROOT=/opt/homelab/config

# Host static LAN IP or Tailscale IP (e.g. 192.168.1.50 or 100.x.y.z)
SERVER_IP=192.168.1.50

# Base domain used for local / Tailscale resolution (e.g. home.lab)
DOMAIN_NAME=home.lab

# Homepage Allowed Hosts (comma-separated list of allowed hostnames/IPs or * for all)
HOMEPAGE_ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 2. Networking & Admin Services
# ------------------------------------------------------------------------------
# Pi-hole Web Admin Password (change this!)
PIHOLE_PASSWORD=ChangeMeAdmin123!

# Reverse Proxy (Nginx Proxy Manager)
# Default NPM login on port 81 is admin@example.com / changeme
# Change it immediately upon first login!

# ------------------------------------------------------------------------------
# 3. Personal Notes (Memos - Google Keep Alternative)
# ------------------------------------------------------------------------------
# Port for Memos web interface
MEMOS_PORT=5230

# ------------------------------------------------------------------------------
# 4. Ebook Library (Kavita)
# ------------------------------------------------------------------------------
# Port for Kavita web reader
KAVITA_PORT=5000

# ------------------------------------------------------------------------------
# 5. Media Streaming (Jellyfin)
# ------------------------------------------------------------------------------
# Port for Jellyfin web interface & streaming
JELLYFIN_PORT=8096

# ------------------------------------------------------------------------------
# 6. Photo & Video Backup (Immich - Lean Profile)
# ------------------------------------------------------------------------------
# Immich Web & API Port
IMMICH_PORT=2283

# Immich Database Credentials (PostgreSQL)
IMMICH_DB_NAME=immich
IMMICH_DB_USER=postgres
IMMICH_DB_PASSWORD=ChangeMeImmichDbSecret!

# Immich Image Tag Release (v3 is current stable major)
IMMICH_VERSION=v3
